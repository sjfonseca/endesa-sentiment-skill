# Endesa Sentiment Analysis Routine - Environment Configuration Template
# Copy this file to .env and fill in your values

# ============================================================================
# REQUIRED: Apify Configuration
# ============================================================================

# Get your API key from: https://apify.com/account#/integrations/api
APIFY_API_KEY=

# ============================================================================
# SENTIMENT ANALYSIS
# ============================================================================

# Threshold for classifying posts as negative
# Range: -1.0 (very negative) to 1.0 (very positive)
# Default: -0.3 (catches moderately negative posts)
# Recommendations:
#   -0.1  : Very sensitive (catches subtle complaints)
#   -0.3  : Balanced (recommended)
#   -0.5  : Strict (only very negative posts)
SENTIMENT_THRESHOLD=-0.3

# ============================================================================
# DATA COLLECTION
# ============================================================================

# Maximum number of Reddit posts to collect per run
# Note: More results = longer runtime and more API calls (higher cost)
# Recommended: 500-1000 for daily runs
MAX_RESULTS=500

# Time range for scraping (week, month, year, all)
# week: Last 7 days
# month: Last 30 days
# year: Last 365 days
# all: No time limit
TIME_RANGE=month

# ============================================================================
# OUTPUT
# ============================================================================

# Directory where CSV and JSON reports will be saved
# Will be created automatically if doesn't exist
OUTPUT_DIR=./results

# Commit and push generated results after a successful run
# Values: true, false
# Default: false. Enable only after reviewing privacy and repository scope.
PUSH_RESULTS=false

# ============================================================================
# LOGGING (Optional)
# ============================================================================

# Log level (debug, info, warn, error)
LOG_LEVEL=info

# Log file location (leave empty to log to console only)
LOG_FILE=./logs/endesa-sentiment.log

# ============================================================================
# NOTIFICATIONS (Optional)
# ============================================================================

# Slack webhook URL for alerts
# Leave empty to disable Slack notifications
# Get from: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=

# Email for reports (requires email service configuration)
REPORT_EMAIL=

# ============================================================================
# DATABASE (Optional - for future enhancement)
# ============================================================================

# PostgreSQL connection string (for storing results in database)
# Format: postgresql://username:password@localhost:5432/database_name
# Leave empty to use CSV file storage only
DATABASE_URL=

# ============================================================================
# SCHEDULING (Optional - for automated runs)
# ============================================================================

# Cron expression for scheduling routine (24-hour format)
# Examples:
#   0 2 * * *     = Every day at 2:00 AM
#   0 */6 * * *   = Every 6 hours
#   0 9 * * 1-5   = Weekdays at 9:00 AM
# Leave empty to run manually only
SCHEDULE_CRON=0 2 * * *

# Enable or disable scheduler
# Values: true, false
ENABLE_SCHEDULER=false

# ============================================================================
# APIFY ACTOR CONFIGURATION
# ============================================================================

# Actor ID to use (may change if Apify updates)
# Default: apify/reddit-post-scraper
# Alternative: apify/reddit-comments-scraper
APIFY_ACTOR_ID=apify~reddit-post-scraper

# Comma-separated list of search queries
# Used if not overridden in code
REDDIT_SEARCH_QUERIES=Endesa Portugal problemas,EDP eletricidade queixa,Endesa fatura indevida,Endesa mau serviço

# Comma-separated list of subreddits to monitor
# Don't include r/ prefix
REDDIT_SUBREDDITS=portugal,legaladvice,personalfinance,relationships

# ============================================================================
# XQUIK APIFY ACTORS FOR X RESEARCH (OPTIONAL)
# ============================================================================

# Safety gates. Dry-run prints inputs without starting an Actor.
X_ACTOR_DRY_RUN=true
X_ACTORS_APPROVED=false
# Required for execution. Set the user-approved positive USD cap.
X_MAX_TOTAL_CHARGE_USD=

# X Tweet Scraper: https://apify.com/xquik/x-tweet-scraper
X_TWEET_ENABLED=false
X_SEARCH_TERMS=Endesa Portugal,EDP fatura
X_TWEET_MAX_ITEMS=100
X_TWEET_MAX_ITEMS_PER_TARGET=25
X_TWEET_OUTPUT_VARIANT=rich
X_TWEET_FIELD_STYLE=camelCase
X_TWEET_OUTPUT_PRESET=flat

# X Follower Scraper: https://apify.com/xquik/x-follower-scraper
X_FOLLOWER_ENABLED=false
X_AUDIENCE_URLS=
X_AUDIENCE_HANDLES=
X_AUDIENCE_LIST_IDS=
X_AUDIENCE_COMMUNITY_IDS=
X_AUDIENCE_RELATION=followers
X_FOLLOWER_MAX_ITEMS=100
X_FOLLOWER_MAX_ITEMS_PER_TARGET=25
X_FOLLOWER_OUTPUT_MODE=full
X_FOLLOWER_DEDUPE_MODE=none

# ============================================================================
# ADVANCED OPTIONS
# ============================================================================

# Request timeout in milliseconds
REQUEST_TIMEOUT=30000

# Actor polling interval in milliseconds (how often to check if actor finished)
POLL_INTERVAL=5000

# Maximum wait time for actor completion in milliseconds
MAX_WAIT_TIME=600000

# Retry failed API calls
# This does not apply to the Xquik runner, which never retries charges.
# Values: true, false
RETRY_ON_FAILURE=true

# Number of retries for failed requests
MAX_RETRIES=3

# ============================================================================
# DEVELOPMENT/TESTING
# ============================================================================

# Use test/mock data instead of real Apify
# Values: true, false
USE_MOCK_DATA=false

# Verbose output (for debugging)
# Values: true, false
VERBOSE=false

# ============================================================================
# NOTE:
# - Only APIFY_API_KEY is required to start
# - Other settings have sensible defaults
# - For production deployment, consider using secrets management
#   (AWS Secrets Manager, HashiCorp Vault, etc.)
# - Never commit this file with real API keys to version control
# ============================================================================
