{
  "name": "endesa-sentiment-routine",
  "version": "1.0.0",
  "description": "Collect and analyze negative sentiment about Endesa in Portugal from Reddit using Apify and Claude Code",
  "main": "src/endesa-sentiment.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/endesa-sentiment.js",
    "dev": "NODE_ENV=development node src/endesa-sentiment.js",
    "test": "jest",
    "schedule": "node src/scheduler.js",
    "logs": "cat logs/*.log",
    "clean": "rm -rf results/* logs/*",
    "setup": "npm install && cp assets/.env.example .env && echo 'Setup complete! Edit .env with your Apify API key.'"
  },
  "keywords": [
    "endesa",
    "sentiment-analysis",
    "reddit",
    "apify",
    "web-scraping",
    "natural-language-processing",
    "data-collection",
    "claude-code"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.19.0",
    "csv-writer": "^1.6.0",
    "dotenv": "^16.0.0",
    "exceljs": "^4.4.0",
    "sentiment": "^0.9.1"
  },
  "devDependencies": {
    "jest": "^29.0.0"
  },
  "optionalDependencies": {
    "node-cron": "^3.0.0",
    "pg": "^8.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": ""
  },
  "bugs": {
    "url": ""
  },
  "homepage": ""
}
